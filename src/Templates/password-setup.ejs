<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8">
    <title>Set up your password - medisync</title>
    <style>
        body {
            background: #99e2b4;
            font-family: 'Segoe UI', Arial, sans-serif;
            margin: 0;
            padding: 0;
        }

        .container {
            max-width: 500px;
            margin: 40px auto 0 auto;
            padding: 48px 32px 40px 32px;
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 4px 24px rgba(0, 0, 0, 0.04);
            text-align: center;
        }

        .logo {
            margin-bottom: 32px;
        }

        .logo img {
            width: 48px;
            height: 48px;
        }

        .headline {
            font-size: 2.2em;
            font-weight: bold;
            color: #333333;
            margin-bottom: 18px;
            margin-top: 0;
        }

        .divider {
            border: none;
            border-top: 1px solid #eee;
            margin: 24px 0;
        }

        .message {
            color: #358f80;
            font-size: 1.08em;
            margin-bottom: 32px;
        }

        .button {
            background: #248277;
            color: #fff;
            padding: 16px 38px;
            border-radius: 30px;
            text-decoration: none;
            font-weight: bold;
            font-size: 1.1em;
            display: inline-block;
            margin-bottom: 20px;
            letter-spacing: 1px;
            box-shadow: 0 2px 8px rgba(36, 130, 119, 0.12);
            transition: background 0.2s;
        }

        .button:hover {
            background: #14746f;
        }

        .footer {
            background: #56ab91;
            color: #fff;
            padding: 40px 0 24px 0;
            margin-top: 48px;
            text-align: center;
        }

        .footer .brand {
            font-size: 1.3em;
            font-weight: bold;
            margin-bottom: 18px;
        }

        .footer .footer-divider {
            border: none;
            border-top: 1px solid #78c6a3;
            margin: 24px 0;
            width: 80%;
        }

        .footer .help {
            color: #fff;
            font-size: 1em;
            margin-top: 18px;
        }

        .footer .help a {
            color: #248277;
            text-decoration: underline;
        }
    </style>
</head>

<body>
    <div class="container">
        <div class="logo">
            <img src="https://cdn-icons-png.flaticon.com/512/3774/3774299.png" alt="medisync Logo" />
        </div>
        <div class="headline">Set up your password</div>
        <hr class="divider" />
        <div class="message">
            Welcome to medisync, Dr. <%= userName %>!<br><br>
                Your account has been approved and is now active. To complete your account setup, please create a secure
                password by clicking the button below.
        </div>
        <a href="<%= setupLink %>" class="button">SET UP PASSWORD</a>
    </div>
    <div class="footer">
        <div class="brand">medisync</div>
        <hr class="footer-divider" />
        <div class="help">
            If you have any questions or concerns, we're here to help. Contact us via our <a href="#">Help Center</a>.
        </div>
    </div>
</body>

</html>